{
  "name": "frame-studio",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node tools/check-wrappers.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test:frames": "node tools/capture-frames.mjs http://localhost:4173/ qa/captures/frames --compare reference/frames/manifest.json",
    "test:smoke": "node tools/smoke-test.mjs http://localhost:4173/ qa/captures/smoke.json",
    "test:budgets": "node tools/scene-stats.mjs http://localhost:4173/ qa/captures/stats.json --budget perf/budgets.json",
    "verify": "bash tools/verify-step.sh http://localhost:4173/"
  },
  "dependencies": {
    "mp4-muxer": "5.2.1",
    "three": "0.128.0",
    "webm-muxer": "5.1.3"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "vite": "7.3.7"
  }
}
