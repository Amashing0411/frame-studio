      "min": -8,
      "max": 8,
      "help": "Slides the texture, in texture widths per second (water, conveyor belts, flames)."
    },
    {
      "key": "affine",
      "scope": "film",
      "group": "texture",
      "type": "range",
      "default": 1,
      "min": 0,
      "max": 1,
      "help": "Texture swimming. 1 = affine mapping like the real PS1, where the texture bends across big polygons that are close to the camera. 0 = a modern, perspective-correct texture."
    },
    {
      "key": "affine_limit",
      "scope": "film",
      "group": "texture",
      "type": "range",
      "default": 0.35,
      "min": 0.05,
      "max": 8,
      "help": "The most the texture may slide because of affine mapping, in texture repeats. Big polygons at the edge of a wide view would otherwise smear the whole texture; a lower value keeps the swimming but caps it. 8 = no cap."
    },
    {
      "key": "pixel_size",
      "scope": "film",
      "group": "snapping",
      "type": "range",
      "default": 3,
      "min": 1,
      "max": 16,
      "help": "Size of one console pixel. The vertices snap to this grid, and the dither cells use it too. 3 on a portrait film = the classic 360 x 640 (on the demo scenes, 320 x 240)."
    },
    {
      "key": "snap_strength",
      "scope": "film",
      "group": "snapping",
      "type": "range",
      "default": 1,
      "min": 0,
      "max": 1,
      "help": "How strongly the vertices snap to the pixel grid. 1 = every vertex jumps to a whole pixel, which makes the edges shimmer when the camera or the object moves. 0 = off."
    },
    {
      "key": "jitter",
      "scope": "film",
      "group": "snapping",
      "type": "range",
      "default": 0,
      "min": 0,
      "max": 2,
      "help": "Random shaking of every vertex, in console pixels (the unstable geometry of the early 3D games). 0 = off."
    },
    {
